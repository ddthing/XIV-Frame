    "prerender:check": "node scripts/sync-transformers-worker.mjs",
    "render:check": "node scripts/validate-image-render-tree.mjs && node scripts/validate-image-layout.mjs && node scripts/validate-character-pixels.mjs && node scripts/validate-cancellation-gate.mjs && node scripts/validate-fallback-queue.mjs && node scripts/validate-pipeline-cache.mjs && node scripts/validate-upload-concurrency.mjs && node scripts/validate-browser-capabilities.mjs && node scripts/validate-wasm-assets.mjs && node scripts/validate-image-memory-policy.mjs && node scripts/validate-background-model-loading-policy.mjs && node scripts/validate-deferred-storage.mjs && node scripts/validate-background-removal-errors.mjs",
    "wasm:check": "node scripts/sync-transformers-worker.mjs && node scripts/validate-wasm-assets.mjs",
    "layout:check": "node scripts/validate-image-layout.mjs",
    "character:check": "node scripts/validate-character-pixels.mjs",
