    "device:check": "node scripts/validate-browser-capabilities.mjs",
    "perf:upload": "node scripts/measure-upload-performance.mjs",
    "perf:soft-blend": "node scripts/measure-soft-blend-performance.mjs",
    "pretest:background:live": "node scripts/sync-transformers-worker.mjs",
    "test:background:live": "node scripts/live-background-removal-smoke.mjs",
    "pretest:e2e": "node scripts/sync-transformers-worker.mjs",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
