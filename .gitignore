.npmrc
.dev.vars*
.wrangler/
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
*.sqlite
*.sqlite3
*.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
