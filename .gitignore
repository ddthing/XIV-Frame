# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/
/public/vendor/transformers.web.min.js
/public/vendor/onnxruntime/

# production
/build

# misc
.DS_Store
*.pem

# local agent/workbench files
/AGENTS.md
/CLAUDE.md
/SKILL.md
/.agent/
/.agents/
/.pnpm-store/
/docs/superpowers/
/scratch/

